# Copy to `.env.local` and fill in secrets. Never commit real keys.

# --- Stellar network ---
# testnet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Horizon (classic accounts, payments, history)
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban JSON-RPC (smart contracts)
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Must match the network you submit transactions to.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Testnet faucet (unused on mainnet)
NEXT_PUBLIC_STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Required only when NEXT_PUBLIC_STELLAR_NETWORK=mainnet (provider-specific)
# NEXT_PUBLIC_STELLAR_MAINNET_RPC_URL=

# --- Assets / contracts ---
# Circle (or other) USDC issuer public key for the selected network
NEXT_PUBLIC_USDC_CODE=USDC
NEXT_PUBLIC_USDC_ISSUER=

# Hub treasury / escrow destination (G... public key)
NEXT_PUBLIC_HUB_TREASURY_PUBLIC_KEY=

# Future Soroban contract ids (C...)
NEXT_PUBLIC_SOROBAN_ESCROW_CONTRACT_ID=
NEXT_PUBLIC_SOROBAN_MARKETPLACE_CONTRACT_ID=

# --- Persistence (pick one; leave the other blank) ---
# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Fiat-to-crypto ramps (prep only) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MONEYGRAM_CLIENT_ID=
MONEYGRAM_CLIENT_SECRET=
